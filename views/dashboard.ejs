<%- include('partials/header') %>
<div class="row">
  <h1>Hi<%= user.full_name ? ', ' + user.full_name : '' %></h1>
  <a class="btn" href="/properties/new">+ Add property</a>
</div>
<% if (!properties.length) { %>
  <div class="card"><p>No properties yet. Add your home to start tracking consumption.</p></div>
<% } %>
<div class="grid">
<% properties.forEach(p => { %>
  <a class="card prop" href="/properties/<%= p.id %>">
    <h2><%= p.name %></h2>
    <p class="muted"><%= p.address || '' %></p>
    <p><strong><%= p.total_kwh.toFixed(0) %></strong> kWh · <strong><%= p.total_paid.toFixed(2) %></strong> <%= user.currency %></p>
    <p class="muted"><%= p.entries %> entries · <%= p.residents %> people</p>
  </a>
<% }) %>
</div>
<%- include('partials/footer') %>
