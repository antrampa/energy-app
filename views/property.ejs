<%- include('partials/header') %>
<div class="row">
  <div>
    <h1><%= property.name %></h1>
    <p class="muted"><%= property.address || '' %></p>
  </div>
  <span>
    <a class="btn secondary" href="/properties/<%= property.id %>/edit">Edit</a>
    <form method="post" action="/properties/<%= property.id %>/delete" class="inline" onsubmit="return confirm('Delete this property and all its entries?')">
      <button class="danger">Delete</button>
    </form>
  </span>
</div>

<div class="card">
  <p><strong>People:</strong> <%= property.residents %></p>
  <p><strong>Devices:</strong> <%= property.devices || '—' %></p>
  <% if (property.notes) { %><p><strong>Details:</strong> <%= property.notes %></p><% } %>
</div>

<div class="card">
  <h2>Add consumption</h2>
  <form method="post" action="/properties/<%= property.id %>/consumptions" id="cform">
    <div class="tabs">
      <label><input type="radio" name="period_type" value="month" checked> Month</label>
      <label><input type="radio" name="period_type" value="year"> Year</label>
      <label><input type="radio" name="period_type" value="range"> Date from–to</label>
    </div>
    <div data-period="month"><label>Month <input type="month" name="month"></label></div>
    <div data-period="year" hidden><label>Year <input type="number" name="year" min="2000" max="2100" placeholder="2026"></label></div>
    <div data-period="range" hidden class="two">
      <label>From <input type="date" name="start_date"></label>
      <label>To <input type="date" name="end_date"></label>
    </div>
    <div class="two">
      <label>kWh <input type="number" step="0.01" min="0" name="kwh" required></label>
      <label>Amount paid (<%= user.currency %>) <input type="number" step="0.01" min="0" name="amount_paid" required></label>
    </div>
    <label>Notes <input name="notes" placeholder="optional"></label>
    <button>Add</button>
  </form>
</div>

<div class="card">
  <h2>History</h2>
  <% if (!entries.length) { %><p class="muted">No entries yet.</p><% } else { %>
  <table>
    <thead><tr><th>Period</th><th>kWh</th><th>Paid</th><th>€/kWh</th><th></th></tr></thead>
    <tbody>
    <% entries.forEach(e => { %>
      <tr>
        <td><%= e.period_type === 'year' ? e.start_date.slice(0,4)
               : e.period_type === 'month' ? e.start_date.slice(0,7)
               : e.start_date + ' → ' + e.end_date %></td>
        <td><%= e.kwh %></td>
        <td><%= e.amount_paid.toFixed(2) %></td>
        <td><%= e.kwh ? (e.amount_paid / e.kwh).toFixed(3) : '—' %></td>
        <td><form method="post" action="/consumptions/<%= e.id %>/delete" class="inline"><button class="link danger">✕</button></form></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<script>
  // Show only the inputs for the chosen period type
  const form = document.getElementById('cform');
  form.addEventListener('change', e => {
    if (e.target.name !== 'period_type') return;
    form.querySelectorAll('[data-period]').forEach(d => d.hidden = d.dataset.period !== e.target.value);
  });
</script>
<%- include('partials/footer') %>
